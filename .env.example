####################################################################
# Dr. Ajay Pundir clinic — environment configuration
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# For local development you can leave EVERYTHING commented out except
# ADMIN_PASSCODE. Tokens will be stored in ./data/clinic.db.
####################################################################


# ── Site ──────────────────────────────────────────────────────────
# Only used for canonical URLs, sitemap.xml and structured data.
# NEXT_PUBLIC_SITE_URL=https://drajaypundir.in


# ── Front desk ────────────────────────────────────────────────────
# REQUIRED for /admin to work at all. Minimum 6 characters.
# Whoever is on the counter types this to open the day's register.
# Use something long and do not reuse a personal password.
ADMIN_PASSCODE=change-this-to-something-long


# ── Database ──────────────────────────────────────────────────────
#
# There are two ways to store tokens, and which one you need depends
# entirely on WHERE you deploy.
#
# ── Option A: local file (development, or a VPS with a real disk) ──
#
# Nothing to set. A SQLite file is created at ./data/clinic.db on first
# use. Override the location if you want:
#
# DATABASE_PATH=./data/clinic.db
#
# ⚠️  This does NOT work on Vercel. Vercel's filesystem is read-only and
#     is wiped between requests, so every token would vanish. The app
#     detects this and refuses to start booking rather than handing out
#     tokens it cannot keep — patients get told to phone instead.
#
# ── Option B: Turso / libSQL (required for Vercel) ─────────────────
#
# Turso is hosted SQLite reached over HTTP. The free tier is far more
# than a single clinic will ever use.
#
#   1. Sign up at https://turso.tech
#   2. Install the CLI, then:
#        turso db create ajay-pundir-clinic
#        turso db show   ajay-pundir-clinic --url
#        turso db tokens create ajay-pundir-clinic
#   3. Put the two values below (and in the Vercel dashboard under
#      Settings → Environment Variables).
#
# Setting TURSO_DATABASE_URL switches the app to Turso automatically —
# there is no other flag to flip. The schema is created on first
# connection, so there is no migration step to run.
#
# TURSO_DATABASE_URL=libsql://ajay-pundir-clinic-yourname.turso.io
# TURSO_AUTH_TOKEN=


# ── Escape hatch — do not use in production ───────────────────────
#
# Lets the app fall back to a throwaway database in the system temp
# directory when no other storage works. Tokens are LOST whenever the
# instance restarts. Only for a throwaway demo; never point real
# patients at it. The /admin screen shows a red warning while this is on.
#
# ALLOW_EPHEMERAL_DB=1
